# Public Supabase project URL and publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Canonical production app origin, with no trailing slash.
NEXT_PUBLIC_APP_URL=https://your-production-domain.example
APP_URL=https://your-production-domain.example

# Supabase server connection (optional fallback aliases)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-side Firebase web API key for email verification
FIREBASE_API_KEY=your-firebase-web-api-key

# Server-only sensitive key (NEVER expose to client or use NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
